# Database
# Local:  both point to the same local postgres instance
# Supabase prod:
#   DATABASE_URL  = Transaction pooler  (port 6543) — used by the app
#   DIRECT_URL    = Direct connection   (port 5432) — used by prisma migrate
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public"

# BetterAuth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="https://your-domain.vercel.app"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Next.js
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Cloudflare R2 (file uploads)
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Optional: set to your r2.dev public URL or custom domain for serving files
# e.g. https://pub-xxxx.r2.dev  or  https://files.yourdomain.com
R2_PUBLIC_URL=""
